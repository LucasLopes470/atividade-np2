algoritmo "SelectionSort"
var
  numeros: vetor[1..10] de inteiro
  i, j, menor, temporario: inteiro

inicio
  para i de 1 ate 10 faca
    escreva("Digite o ", i, "o numero: ")
    leia(numeros[i])
  fimpara

  para i de 1 ate 9 faca
    menor <- i

    para j de i + 1 ate 10 faca
      se numeros[j] < numeros[menor] entao
        menor <- j
      fimse
    fimpara

    se menor <> i entao
      temporario <- numeros[i]
      numeros[i] <- numeros[menor]
      numeros[menor] <- temporario
    fimse
  fimpara

  escreval("Numeros em ordem crescente:")

  para i de 1 ate 10 faca
    escreva(numeros[i], " ")
  fimpara
  escreval("")

fimalgoritmo
